# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ใส่ anon key หรือ publishable key
# ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น สำหรับลบบัญชีผู้เรียนหลังจบกิจกรรม FR-052 ห้ามขึ้นต้นด้วย NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=ใส่ service role key หรือ secret key
